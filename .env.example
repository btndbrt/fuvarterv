# Copy to .env and fill in from your Supabase project (Settings → API).
# Both values are safe to expose in the browser; Row Level Security protects the
# data. Do NOT put the service_role / secret key here.
#
# The service_role key IS needed by the invite function (ADR-30), but it belongs in
# Netlify's environment variables as SUPABASE_SERVICE_ROLE_KEY and nowhere else.
# Anything in this file that starts with VITE_ is compiled into the public bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
